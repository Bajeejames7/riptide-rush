{
  "name": "riptide-rush",
  "version": "1.0.0",
  "description": "Original procedural arcade powerboat racing",
  "author": "Riptide Rush",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --configLoader native",
    "start": "electron .",
    "test": "node --test --test-isolation=none test/*.test.js",
    "dist": "npm run build && node scripts/icon.mjs && node scripts/package.mjs"
  },
  "dependencies": {
    "three": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "games.riptiderush.arcade",
    "productName": "Riptide Rush",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/core/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Riptide-Rush-Setup-${version}-${arch}.exe"
    },
    "npmRebuild": false,
    "forceCodeSigning": false,
    "portable": {
      "artifactName": "Riptide-Rush-Portable-${version}-${arch}.exe"
    }
  }
}
